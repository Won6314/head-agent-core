{
  "hooks": {
    "SessionStart": [{"hooks": [{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs"],"timeout":20}]}],
    "UserPromptSubmit": [{"hooks": [{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs"],"timeout":5}]}],
    "Stop": [{"hooks": [{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs"],"timeout":5}]}],
    "PermissionRequest": [{"hooks": [{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs"],"timeout":5}]}],
    "SessionEnd": [{"hooks": [{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs"],"timeout":15}]}],
    "SubagentStart": [{"hooks": [{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs"],"timeout":5}]}],
    "SubagentStop": [{"hooks": [{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs"],"timeout":5}]}],
    "PreToolUse": [{"matcher":"^mcp__plugin_head-context_context__session_(list|load|create|save|finish|branch|read)$|^AskUserQuestion$","hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs"],"timeout":5}]}],
    "PostToolUse": [{"matcher":"^AskUserQuestion$","hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs"],"timeout":5}]}]
  }
}
