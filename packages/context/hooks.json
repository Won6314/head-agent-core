{
  "head-context-start": {
    "SessionStart": [
      { "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/antigravity-hook.mjs\"", "timeout": 20 }
    ]
  },
  "head-context-invocation": {
    "PreInvocation": [
      { "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/antigravity-hook.mjs\"", "timeout": 20 }
    ]
  },
  "head-context-pretool": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/antigravity-pretool.mjs\"", "timeout": 10 }
        ]
      }
    ]
  }
}
